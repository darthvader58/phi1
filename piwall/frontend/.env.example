MONGODB_URI=mongodb://127.0.0.1:27017/pitwall
MONGODB_DB=pitwall
AUTH_SECRET=replace-with-a-long-random-string
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Where the Next.js server reaches the backend. Server-side only; under
# docker compose this is http://backend:8000, because inside the frontend
# container "localhost" is the container itself.
BACKEND_API_URL=http://localhost:8000
# Browser-facing. Inlined into the client bundle at build time.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
