MONGODB_URI=mongodb://127.0.0.1:27017/pitwall
MONGODB_DB=pitwall
AUTH_SECRET=replace-with-a-long-random-string
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Where the Next.js server reaches the backend. Server-side only; under
# docker compose this is http://backend:8000, because inside the frontend
# container "localhost" is the container itself.
BACKEND_API_URL=http://localhost:8000
# Browser-facing. Inlined into the client bundle at build time.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Proves to the backend that a register call came from this server rather
# than the open internet, and is what /api/register buckets its rate limit
# on. Must be byte-identical to the backend's PROVISIONING_SECRET; a
# mismatch fails exactly like a missing value (every register call 404s).
# Server-side only — never rename this to NEXT_PUBLIC_*, which would inline
# the secret into the browser bundle at build time.
# Generate with: openssl rand -hex 32
PROVISIONING_SECRET=replace-with-a-long-random-string
