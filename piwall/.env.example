# Compose stack configuration. Copy to .env and fill in.

# --- MongoDB (shared by the backend and the Next.js server) ---
MONGO_ROOT_USERNAME=piwall
MONGO_ROOT_PASSWORD=change-me-before-deploying
MONGODB_DB=phi1

# --- Backend ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Next.js, server-side (read inside the frontend container) ---
# NextAuth signing secret and Google OAuth credentials. Leave the Google pair
# empty to run with email/password sign-in only.
AUTH_SECRET=change-me-before-deploying
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The public URL the app is served on, used by NextAuth for callbacks.
NEXTAUTH_URL=http://localhost:3000

# --- Browser-facing ---
# Dialled by the visitor's browser, so it must be reachable from outside the
# compose network. Baked into the client bundle at build time; changing it
# requires a rebuild, not just a restart.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Note: the frontend reaches the backend over the compose network at
# http://backend:8000. That is set as BACKEND_API_URL in docker-compose.yml
# and is not configured here; "localhost" would resolve to the frontend
# container itself. Outside compose, set BACKEND_API_URL (or the legacy
# NEXT_PUBLIC_API_URL) to wherever the backend is listening.
