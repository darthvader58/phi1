FROM node:22-alpine

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .

# Baked into the client bundle at build time: Next.js inlines NEXT_PUBLIC_*
# during `next build`, so setting it only as a runtime env would never reach
# the browser. This is the address the visitor's browser dials, not an
# in-network one.
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8000
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL

RUN npm run build

EXPOSE 3000

CMD ["sh", "-c", "npm run start -- --hostname 0.0.0.0 --port ${PORT:-3000}"]
